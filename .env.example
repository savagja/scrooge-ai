# ════════════════════════════════════════════════════════════
# SECRETS — Set once, never touch again.
# Copy to .env and fill in your actual keys.
# ════════════════════════════════════════════════════════════

# Alpaca API Credentials
# Get from: https://alpaca.markets/
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Set to true for paper trading (REQUIRED for testing)
ALPACA_PAPER=true

# OpenRouter API Key
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenRouter Model (cheap options for high-frequency analysis)
# Options:
#   google/gemini-flash-1.5-8b        (fast, ~$0.15/M tokens — RECOMMENDED)
#   deepseek/deepseek-chat:free       (free tier, rate limited)
#   anthropic/claude-3.5-haiku        (~$0.80/M tokens, excellent JSON)
#   meta-llama/llama-3.3-70b-instruct (cheap, decent)
OPENROUTER_MODEL=google/gemini-flash-1.5-8b
